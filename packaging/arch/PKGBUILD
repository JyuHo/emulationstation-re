# Builds the package from this source tree (the release workflow runs it from packaging/arch):
#   ES_VERSION=1.2.0 makepkg -f
# Without ES_VERSION, the version comes from `git describe`.

pkgname=emulationstation-re
pkgver=0.0.0
pkgrel=1
pkgdesc="Graphical front-end for emulators with controller navigation (Linux build of Batocera's EmulationStation)"
arch=('x86_64')
url="https://github.com/JyuHo/emulationstation-re"
license=('MIT' 'LGPL-3.0-or-later')
depends=('sdl3' 'freeimage' 'freetype2' 'curl' 'vlc' 'alsa-lib' 'fribidi' 'libcec' 'systemd-libs' 'libglvnd')
makedepends=('cmake' 'ninja' 'rapidjson' 'gettext' 'git')
optdepends=('noto-fonts-cjk: Chinese, Japanese and Korean characters'
            'polkit: updates from the menu'
            'flatpak: Flatpak emulators of the emulator catalog')
conflicts=('emulationstation')
options=('!debug')

_srcroot="$(realpath "$startdir/../..")"

pkgver() {
  local version="${ES_VERSION:-$(git -C "$_srcroot" describe --tags --match 'v[0-9]*' 2>/dev/null)}"
  version="${version#v}"
  # pacman versions cannot hold "-": 1.2.0-3-gabcdef -> 1.2.0.r3.gabcdef
  version="$(printf '%s' "${version:-0.0.0}" | sed -E 's/-([0-9]+)-g/.r\1.g/; s/-/./g')"
  printf '%s\n' "$version"
}

build() {
  cmake -S "$_srcroot" -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DGL=ON \
    ${ES_VERSION:+-DES_VERSION="$ES_VERSION"}
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
  install -Dm644 "$_srcroot/LICENSE.md" "$pkgdir/usr/share/licenses/$pkgname/LICENSE.md"
}
